        {
          "info": {
            "name": "Submit quote.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.backpack.exchange/api/v1/rfq/quote",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "X-SIGNATURE",
                "value": ""
              },
              {
                "name": "X-TIMESTAMP",
                "value": ""
              },
              {
                "name": "X-WINDOW",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit a quote in response to an RFQ. If valid, the quote may be\naccepted within the specified time window.\n\n**Instruction:** `quoteSubmit`"
        },
        {
          "info": {
            "name": "Get open RFQs.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.backpack.exchange/api/v1/rfqs",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "X-SIGNATURE",
                "value": ""
              },
              {
                "name": "X-TIMESTAMP",
                "value": ""
              },
              {
                "name": "X-WINDOW",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "symbol",
                "value": "",
                "type": "query",
                "description": "Filter by market symbol."
              },
              {
                "name": "rfqId",
                "value": "",
                "type": "query",
                "description": "Filter by RFQ ID."
              },
              {
                "name": "deferredSettlement",
                "value": "",
                "type": "query",
                "description": "Filter for deferred settlement RFQs only (`true`), non-deferred\nonly (`false`), or return all (`null`/omitted)."
              },
              {
                "name": "subaccountId",
                "value": "",
                "type": "query",
                "description": "Subaccount ID for unsigned requests."
              }
            ]
          },
          "docs": "Retrieves open RFQs submitted by the account, along with the quotes\nsubmitted for them. Optionally filter by symbol, RFQ ID, or deferred\nsettlement status.\n\n**Instruction:** `rfqQuery`"
        },
