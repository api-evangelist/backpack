                "name": "X-WINDOW",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "rfqId",
                "value": "",
                "type": "query",
                "description": "Filter to the given rfq."
              },
              {
                "name": "symbol",
                "value": "",
                "type": "query",
                "description": "Filter to the given symbol."
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter to the given status."
              },
              {
                "name": "side",
                "value": "",
                "type": "query",
                "description": "Filter to the given side."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number to return. Default `100`, maximum `1000`."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Offset. Default `0`."
              },
              {
                "name": "sortDirection",
                "value": "",
                "type": "query",
                "description": "Sort direction."
              },
              {
                "name": "deferredSettlement",
                "value": "",
                "type": "query",
                "description": "Filter to deferred settlement RFQs only (`true`) or non-deferred only (`false`)."
              }
            ]
